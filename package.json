{
  "name": "burniqo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate 2>/dev/null || echo '⚠️  Prisma generate skipped (no DB yet)'",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "pm2:start": "pm2 start ecosystem.config.js --env development",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "watch:all": "npm-run-all --parallel dev pm2:restart",
    "watch:seed": "nodemon --watch scripts/ --ext ts --exec \"npm run pm2:restart\""
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/client": "^5.14.0",
    "@types/axios": "^0.9.36",
    "autoprefixer": "^10.4.0",
    "axios": "^1.16.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.17.0",
    "next": "^16.2.6",
    "next-auth": "^4.24.14",
    "postcss": "^8.5.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.8.1",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "next-sitemap": "^4.2.3",
    "npm-run-all": "^4.1.5",
    "pm2": "^5.4.3",
    "prisma": "^5.14.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  }
}
