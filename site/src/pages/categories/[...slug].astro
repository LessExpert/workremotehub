---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";

export async function getStaticPaths() {
  // Predefined clusters from config — ensures these pages never 404
  const PREDEFINED_CATEGORIES = [
    "home-office-setup", "remote-work-tools", "productivity", "digital-nomad"
  ];

  const articleModules = import.meta.glob("../../content/articles/*.mdx", { eager: false });
  const tagSet = new Set<string>();

  // Add predefined categories
  for (const cat of PREDEFINED_CATEGORIES) {
    tagSet.add(cat);
  }

  // Add tags from articles
  for (const _path of Object.keys(articleModules)) {
    try {
      const mod = await articleModules[_path]() as any;
      const tags = mod.frontmatter?.tags || [];
      for (const t of tags) {
        tagSet.add(t);
      }
    } catch { /* skip */ }
  }

  return Array.from(tagSet).map((tag) => ({
    params: { slug: tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;

const allModules = import.meta.glob("../../content/articles/*.mdx", { eager: true });

const filtered: Array<any> = [];
for (const [_, mod] of Object.entries(allModules)) {
  const m = mod as any;
  if (m.frontmatter && !m.frontmatter.draft && m.frontmatter.tags?.includes(tag)) {
    filtered.push(m);
  }
}

filtered.sort(
  (a, b) =>
    new Date(b.frontmatter.pubDate).getTime() -
    new Date(a.frontmatter.pubDate).getTime()
);

const displayName = tag.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
const totalWords = filtered.reduce((s, a) => s + (a.frontmatter.wordCount || 0), 0);
---

<BaseLayout title={displayName} description={`Articles about ${displayName} for remote workers`}>
  <div class="container category-page">
    <div class="category-header">
      <h1>{displayName}</h1>
      <p>{filtered.length > 0 ? `${filtered.length} article${filtered.length !== 1 ? "s" : ""} · ${totalWords.toLocaleString()} total words` : "No articles yet — check back soon"}</p>
    </div>

    {filtered.length > 0 ? (
      <div class="article-grid">
        {filtered.map((article) => (
          <ArticleCard
            title={article.frontmatter.title}
            slug={article.frontmatter.slug}
            excerpt={article.frontmatter.description}
            pubDate={article.frontmatter.pubDate}
            tags={article.frontmatter.tags}
            wordCount={article.frontmatter.wordCount}
            contentType={article.frontmatter.contentType}
          />
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <h3>📭 No articles in this category yet</h3>
        <p>We're working on it! The content pipeline generates {displayName} articles automatically every week. Check back soon.</p>
        <a href="/" style="display:inline-block; margin-top:1rem; padding:0.5rem 1.25rem; background:var(--brand-600); color:white; border-radius:8px; font-weight:600;">Browse All Articles →</a>
      </div>
    )}
  </div>
</BaseLayout>