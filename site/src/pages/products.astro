---
import BaseLayout from "../layouts/BaseLayout.astro";

const PRODUCTS = [
  {
    title: "Home Office Setup Checklist",
    description: "A comprehensive PDF checklist covering everything you need for the perfect remote workspace — from ergonomics to cable management.",
    price: "$9",
    category: "PDF Guide",
    gumroad: "WORKREMOTEHUB/REMOTE-SETUP",  // Replace after creating product
    icon: "✅",
    features: [
      "50+ item checklist",
      "Room-by-room breakdown",
      "Budget tiers ($500/$1000/$2000)",
      "Ergonomic assessment guide",
    ],
  },
  {
    title: "Digital Nomad Budget Spreadsheet",
    description: "Track your expenses, income, and savings across multiple currencies. Built for location-independent workers.",
    price: "$15",
    category: "Spreadsheet",
    gumroad: "WORKREMOTEHUB/NOMAD-BUDGET",
    icon: "📊",
    features: [
      "Multi-currency support",
      "Monthly & annual views",
      "Tax deduction tracker",
      "Goal tracking dashboard",
    ],
  },
  {
    title: "Notion Remote Work Dashboard",
    description: "All-in-one Notion template for task management, habit tracking, meeting notes, and goal setting.",
    price: "$12",
    category: "Template",
    gumroad: "WORKREMOTEHUB/NOTION-DASHBOARD",
    icon: "📋",
    features: [
      "Task management system",
      "Meeting notes database",
      "Habit tracker",
      "Weekly review template",
    ],
  },
  {
    title: "Ultimate Home Office Buyer's Guide",
    description: "60-page ebook covering desks, chairs, monitors, lighting, audio, and accessories — with product recommendations at every price point.",
    price: "$19",
    category: "Ebook",
    gumroad: "WORKREMOTEHUB/BUYERS-GUIDE",
    icon: "📖",
    features: [
      "60+ pages of research",
      "50+ product recommendations",
      "Budget, mid-range, premium tiers",
      "Amazon product links included",
    ],
  },
];
---

<BaseLayout title="Products" description="Digital products and resources for remote workers">
  <div class="container" style="padding: 3rem 0;">
    <div style="text-align:center; margin-bottom: 3rem;">
      <h1 style="margin-bottom: 0.5rem;">📦 Digital Products</h1>
      <p style="color:var(--gray-500); max-width:500px; margin:0 auto;">
        Handcrafted templates, guides, and tools to help you work better remotely.
      </p>
    </div>

    <div class="article-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
      {PRODUCTS.map((product) => (
        <article
          class="article-card"
          style="display:flex; flex-direction:column;"
        >
          <div
            class="article-card-image"
            style="font-size:3rem; height:140px;"
          >
            {product.icon}
          </div>
          <div class="article-card-body" style="flex:1; display:flex; flex-direction:column;">
            <div class="card-meta">
              <span class="card-meta-badge">{product.category}</span>
            </div>
            <h2 style="font-size:1.1rem;">{product.title}</h2>
            <p style="font-size:0.88rem; color:var(--gray-500); flex:1; margin-top:0.5rem;">
              {product.description}
            </p>

            <div style="margin:0.75rem 0;">
              {product.features.map((f) => (
                <div style="font-size:0.8rem; color:var(--gray-600); padding:0.25rem 0;">
                  ✓ {f}
                </div>
              ))}
            </div>

            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:auto; padding-top:1rem; border-top:1px solid var(--gray-100);">
              <span style="font-size:1.5rem; font-weight:800; color:var(--gray-900);">{product.price}</span>
              <a
                href={`https://gumroad.com/l/${product.gumroad}`}
                target="_blank"
                rel="noopener"
                style="
                  background:var(--brand-600);
                  color:white;
                  padding:0.5rem 1.25rem;
                  border-radius:8px;
                  font-weight:600;
                  font-size:0.9rem;
                  text-decoration:none;
                  transition:all 0.15s;
                "
              >Buy Now →</a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- How it works -->
    <div style="
      margin-top: 4rem;
      padding: 2rem;
      background: var(--gray-50);
      border: 1px solid var(--gray-200);
      border-radius: 12px;
      text-align: center;
    ">
      <h2 style="margin-bottom: 1rem;">💡 Want a custom product?</h2>
      <p style="color:var(--gray-500); max-width:500px; margin:0 auto 1.5rem;">
        Have an idea for a template, guide, or tool that would help your workflow? 
        I'm open to creating custom digital products.
      </p>
      <a href="/about" style="color:var(--brand-600); font-weight:600;">Get in touch →</a>
    </div>
  </div>

  <!-- Gumroad script for checkout -->
  <script src="https://gumroad.com/js/gumroad.js" async></script>
</BaseLayout>