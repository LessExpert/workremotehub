---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";
---

<BaseLayout title="Free Remote Work Setup Guide" description="Download our free home office setup checklist">
  <div class="container-narrow" style="padding: 3rem 0; text-align: center;">
    <!-- Lead Magnet Header -->
    <div class="hero-badge" style="margin: 0 auto 1rem;">🎁 Free Download</div>
    <h1 style="font-size: 2.5rem; margin-bottom: 0.75rem;">
      The Ultimate Home Office <br/>Setup Checklist
    </h1>
    <p style="color: var(--gray-500); font-size: 1.1rem; max-width: 500px; margin: 0 auto 2rem;">
      Everything you need to build a comfortable, productive workspace — 
      from ergonomics to cable management. 50+ items across 8 categories.
    </p>

    <!-- Value Props -->
    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; margin-bottom: 2rem; text-align: left;">
      <div style="background:var(--gray-50); border-radius:8px; padding:1rem;">
        <div style="font-size:1.5rem; margin-bottom:0.5rem;">🪑</div>
        <h4 style="font-size:0.9rem;">Ergonomics</h4>
        <p style="font-size:0.8rem; color:var(--gray-500);">Chair height, monitor position, desk setup</p>
      </div>
      <div style="background:var(--gray-50); border-radius:8px; padding:1rem;">
        <div style="font-size:1.5rem; margin-bottom:0.5rem;">🔌</div>
        <h4 style="font-size:0.9rem;">Gear Checklist</h4>
        <p style="font-size:0.8rem; color:var(--gray-500);">Monitors, keyboards, audio, lighting</p>
      </div>
      <div style="background:var(--gray-50); border-radius:8px; padding:1rem;">
        <div style="font-size:1.5rem; margin-bottom:0.5rem;">📋</div>
        <h4 style="font-size:0.9rem;">Budget Tiers</h4>
        <p style="font-size:0.8rem; color:var(--gray-500);">$500, $1,000, and $2,000 setups</p>
      </div>
    </div>

    <!-- Signup Form -->
    <div style="
      background: linear-gradient(135deg, var(--brand-600), var(--brand-800));
      border-radius: 16px;
      padding: 2.5rem 2rem;
      color: white;
      max-width: 480px;
      margin: 0 auto;
    ">
      <h3 style="color: white; font-size: 1.25rem; margin-bottom: 0.5rem;">
        Get Your Free Checklist
      </h3>
      <p style="font-size: 0.9rem; opacity: 0.85; margin-bottom: 1.5rem;">
        Sent straight to your inbox. No spam, unsubscribe anytime.
      </p>

      <!-- Update this form action with your Buttondown / Mailchimp / ConvertKit URL -->
      <form
        action="https://buttondown.email/api/emails/embed-subscribe/{YOUR_USERNAME}"
        method="post"
        target="popupwindow"
        class="newsletter-form"
        style="flex-direction: column;"
      >
        <input
          type="email"
          name="email"
          placeholder="your@email.com"
          required
          style="
            width: 100%;
            padding: 0.75rem 1rem;
            border-radius: 8px;
            border: none;
            font-size: 1rem;
            font-family: var(--font-sans);
            margin-bottom: 0.75rem;
          "
        />
        <button
          type="submit"
          style="
            width: 100%;
            padding: 0.75rem;
            background: var(--accent-500);
            color: white;
            font-weight: 700;
            font-size: 1rem;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.15s;
            font-family: var(--font-sans);
          "
        >
          📥 Send Me the Free Checklist
        </button>
      </form>
      <p style="font-size: 0.75rem; opacity: 0.7; margin-top: 0.75rem;">
        By subscribing, you agree to receive emails from {SITE.title}.
      </p>
    </div>

    <!-- Testimonial / Social Proof -->
    <div style="margin-top: 3rem; padding: 1.5rem; background: var(--gray-50); border-radius: 12px;">
      <p style="font-style: italic; color: var(--gray-500);">
        "This checklist saved me hours of research when setting up my home office. 
        The budget tiers were especially helpful."
      </p>
      <p style="font-size: 0.85rem; color: var(--gray-400); margin-top: 0.5rem;">
        — Alex, Remote Worker
      </p>
    </div>
  </div>
</BaseLayout>