---
import BaseLayout from "./BaseLayout.astro";
import AdPlaceholder from "../components/AdPlaceholder.astro";
import { SITE } from "../config";

export interface Props {
  title: string;
  description?: string;
  pubDate?: string;
  contentType?: string;
  wordCount?: number;
  tags?: string[];
  schema?: Record<string, unknown>;
  affiliateLinks?: Array<{ text: string; url: string }>;
}

const {
  title,
  description,
  pubDate,
  contentType,
  wordCount,
  tags = [],
  schema = {},
  affiliateLinks = [],
} = Astro.props;

const readingTime = wordCount ? Math.max(1, Math.ceil(wordCount / 200)) + " min read" : "";
const contentTypes: Record<string, string> = {
  roundup: "Roundup Review",
  comparison: "Comparison",
  guide: "Guide",
  listicle: "Listicle",
  review: "Product Review",
};
---

<BaseLayout title={title} description={description}>
  <article class="article-page">
    <div class="container article-layout">
      <!-- Main Content -->
      <div>
        <header class="article-header-page">
          <div class="breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <a href={`/categories/${tags[0] || "uncategorized"}`}>{contentTypes[contentType || ""] || "Article"}</a>
            <span>/</span>
            <span style="color:var(--gray-500);">{title.slice(0, 40)}...</span>
          </div>

          <h1>{title}</h1>

          <div class="article-header-meta">
            {pubDate && (
              <span class="meta-item">📅 <time datetime={pubDate}>{pubDate}</time></span>
            )}
            {contentType && (
              <span class="meta-item">📁 <span class="tag-badge">{contentTypes[contentType] || contentType}</span></span>
            )}
            {readingTime && <span class="meta-item">⏱ {readingTime}</span>}
            {wordCount && <span class="meta-item">📝 {wordCount} words</span>}
          </div>

          {tags.length > 0 && (
            <div style="display:flex; gap:0.4rem; flex-wrap:wrap;">
              {tags.map((tag) => (
                <a href={`/categories/${tag}`} class="category-pill" style="font-size:0.8rem;">{tag}</a>
              ))}
            </div>
          )}
        </header>

        <div class="article-body">
          <slot />
        </div>

        <AdPlaceholder position="after-content" />

        <!-- Author Bio -->
        <div class="author-bio">
          <div class="author-avatar">
            {SITE.author[0]}
          </div>
          <div class="author-info">
            <h4>{SITE.author}</h4>
            <p>Remote work enthusiast and productivity gear reviewer. I test home office equipment so you don't have to.</p>
          </div>
        </div>

        <!-- Share Buttons -->
        <div class="share-buttons">
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(SITE.url + Astro.url.pathname)}`}
            target="_blank"
            rel="noopener"
            class="share-btn"
          >𝕏 Share on X</a>
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(SITE.url + Astro.url.pathname)}`}
            target="_blank"
            rel="noopener"
            class="share-btn"
          >f Share</a>
          <button
            class="share-btn"
            onclick="navigator.clipboard.writeText(window.location.href); this.innerText='✓ Copied!'"
          >🔗 Copy Link</button>
        </div>

        {affiliateLinks.length > 0 && (
          <div class="affiliate-disclosure">
            <h4>🛒 Products mentioned in this article</h4>
            <ul>
              {affiliateLinks.slice(0, 8).map((link) => (
                <li>
                  <a href={link.url} rel="nofollow sponsored" target="_blank">
                    {link.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Schema.org structured data -->
        {Object.keys(schema).length > 0 && (
          <script type="application/ld+json" set:html={JSON.stringify({
            ...schema,
            "@context": "https://schema.org",
            mainEntityOfPage: { "@type": "WebPage", "@id": Astro.url.href },
            publisher: { "@type": "Organization", name: SITE.title },
          })}></script>
        )}
      </div>

      <!-- Sidebar -->
      <aside class="sidebar">
        <div class="sidebar-card">
          <h3>📖 Table of Contents</h3>
          <nav class="toc">
            <ol>
              <li><a href="#overview">Overview</a></li>
              <li><a href="#features">Key Features</a></li>
              <li><a href="#comparison">Comparison</a></li>
              <li><a href="#verdict">Final Verdict</a></li>
            </ol>
          </nav>
        </div>

        <div class="sidebar-card">
          <h3>⚡ Related Guides</h3>
          <ul>
            <li><a href="/">Best Home Office Setup 2025</a></li>
            <li><a href="/">Top Productivity Tools</a></li>
            <li><a href="/">Digital Nomad Starter Kit</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>