---
import BaseLayout from "./BaseLayout.astro";
import AdPlaceholder from "../components/AdPlaceholder.astro";

export interface Props {
  title: string;
  description?: string;
  pubDate?: string;
  contentType?: string;
  wordCount?: number;
  tags?: string[];
  schema?: Record<string, unknown>;
  affiliateLinks?: Array<{ text: string; url: string }>;
}

const {
  title,
  description,
  pubDate,
  contentType,
  wordCount,
  tags = [],
  schema = {},
  affiliateLinks = [],
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <!-- Article-level structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(
    Object.keys(schema).length > 0
      ? schema
      : {
          "@context": "https://schema.org",
          "@type": "Article",
          headline: title,
          description: description,
          author: { "@type": "Person", name: "Alex" },
          datePublished: pubDate,
        }
  )}></script>

  <article class="container" style="padding-top: 2rem; padding-bottom: 2rem;">
    <header class="article-header">
      <h1>{title}</h1>
      <div class="article-meta">
        {pubDate && <time datetime={pubDate}>{pubDate}</time>}
        {wordCount && <span> · {wordCount} words</span>}
        {contentType && <span> · {contentType}</span>}
      </div>
      {tags.length > 0 && (
        <div style="margin-top: 0.5rem;">
          {tags.map((tag) => (
            <span class="tag-badge">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <div class="article-body">
      <slot />
    </div>

    <!-- In-content ad placeholder (after article text, before disclosure) -->
    <AdPlaceholder position="after-content" />

    {affiliateLinks.length > 0 && (
      <div class="affiliate-disclosure">
        <p><strong>Products mentioned in this article:</strong></p>
        <ul>
          {affiliateLinks.map((link) => (
            <li>
              <a href={link.url} class="affiliate-link" rel="sponsored" target="_blank">
                {link.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </article>
</BaseLayout>