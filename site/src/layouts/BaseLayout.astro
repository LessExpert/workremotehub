---
import { SITE } from "../config";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const pageTitle = `${title} | ${SITE.title}`;
const pageDesc = description || SITE.description;
const pageOgImage = ogImage || SITE.ogImage;
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDesc} />
    <meta name="author" content={SITE.author} />
    <meta name="theme-color" content="#2563eb" />
    <!-- Impact Site Verification -->
    <meta name="Impact-Site-Verification" content="f53e62fe-378a-4082-885a-6fbe86b2005a" />

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content={new URL(pageOgImage, SITE.url).href} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={SITE.locale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />

    <!-- Canonical -->
    <link rel="canonical" href={Astro.url.href} />

    <!-- Feed -->
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS Feed`} href="/rss.xml" />

    <title>{pageTitle}</title>

    <!-- Google AdSense -->

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-M2J1K76PQV"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-M2J1K76PQV');
    </script>    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1687318913855124" crossorigin="anonymous"></script>

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Blog",
      "name": SITE.title,
      "description": SITE.description,
      "url": SITE.url,
      "author": { "@type": "Person", "name": SITE.author },
    })}></script>

    <!-- Inline critical CSS for fast first paint -->
    <style set:html={`
      *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
      body{font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:var(--gray-800,#1f2937);background:#fff;line-height:1.7}
      .container{width:100%;max-width:1200px;margin:0 auto;padding:0 1.5rem}
      .site-header{background:#fff;border-bottom:1px solid #e5e7eb;position:sticky;top:0;z-index:100}
      .site-header .container{display:flex;align-items:center;justify-content:space-between;height:64px}
      .site-logo{font-size:1.25rem;font-weight:800;color:#111827;letter-spacing:-0.02em;text-decoration:none}
    `}></style>
  </head>
  <body>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>