---
/**
 * Ad Placement Component
 *
 * Google AdSense is loaded globally in BaseLayout.astro.
 * If Auto Ads is enabled in your AdSense dashboard, Google
 * automatically places ads without needing manual ad units.
 * 
 * This component shows an in-article ad placeholder when
 * auto ads aren't yet active.
 */

export interface Props {
  position: "in-article" | "sidebar" | "after-content";
  /** For in-article: after which paragraph number */
  afterParagraph?: number;
}

const { position, afterParagraph = 3 } = Astro.props;

// ── Google AdSense publisher ID ──
const PUBLISHER_ID = "ca-pub-1687318913855124";
const ADS_ENABLED = true;  // Set to false to show placeholder again
---

{ADS_ENABLED ? (
  // Auto ads handles everything — Google scans the page and places ads
  // No manual ad units needed if Auto Ads is on in your AdSense dashboard
  <div style="margin: 1.5rem 0;">
    <ins
      class="adsbygoogle"
      style="display:block; text-align:center;"
      data-ad-layout="in-article"
      data-ad-format="fluid"
      data-ad-client={PUBLISHER_ID}
      data-ad-slot=""
    ></ins>
    <script set:html="(adsbygoogle = window.adsbygoogle || []).push({})"></script>
  </div>
) : (
  // ── Placeholder (shown while AdSense isn't active) ──
  <div
    style="
      background: var(--color-bg-alt);
      border: 2px dashed var(--color-border);
      border-radius: 8px;
      padding: 2rem 1rem;
      text-align: center;
      margin: 1.5rem 0;
      font-size: 0.85rem;
      color: var(--color-text-muted);
    "
  >
    <p style="font-weight: 600; margin-bottom: 0.3rem;">📢 Advertisement</p>
    <p>This space reserved for ads once the site reaches traffic thresholds.</p>
  </div>
)}