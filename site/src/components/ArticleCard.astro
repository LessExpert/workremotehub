---
export interface Props {
  title: string;
  slug: string;
  excerpt?: string;
  pubDate?: string;
  tags?: string[];
  wordCount?: number;
  contentType?: string;
  image?: string;
}

const { title, slug, excerpt, pubDate, tags = [], wordCount, contentType, image } = Astro.props;

// Content type icons (fallback only)
const typeIcons: Record<string, string> = {
  roundup: "⭐",
  comparison: "⚖️",
  guide: "📖",
  listicle: "📋",
  review: "🔍",
};

const typeIcon = typeIcons[contentType || ""] || "📄";
const readingTime = wordCount ? Math.max(1, Math.ceil(wordCount / 200)) + " min read" : "";
---

<article class="article-card">
  <a href={`/${slug}/`} class="article-card-image-link">
    {image ? (
      <div class="article-card-image">
        <img
          src={image}
          alt={title}
          loading="lazy"
          width="800"
          height="400"
          style="width:100%;height:100%;object-fit:cover;"
        />
      </div>
    ) : (
      <div class="article-card-image article-card-image-fallback">
        {typeIcon}
      </div>
    )}
  </a>
  <div class="article-card-body">
    <div class="card-meta">
      <span class="card-meta-badge">{contentType || "article"}</span>
      {pubDate && <span>{pubDate}</span>}
      {readingTime && <span>{readingTime}</span>}
    </div>

    <h2>
      <a href={`/${slug}/`}>{title}</a>
    </h2>

    {excerpt && <p class="excerpt">{excerpt}</p>}

    {tags.length > 0 && (
      <div class="tags">
        {tags.slice(0, 4).map((tag) => (
          <a href={`/categories/${tag}`} class="tag">{tag}</a>
        ))}
        {tags.length > 4 && <span class="tag">+{tags.length - 4}</span>}
      </div>
    )}
  </div>
</article>

<style>
  .article-card-image-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .article-card-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
    border-radius: 8px 8px 0 0;
    background: var(--gray-100, #f3f4f6);
  }
  .article-card-image img {
    transition: transform 0.3s ease;
  }
  .article-card:hover .article-card-image img {
    transform: scale(1.05);
  }
  .article-card-image-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    background: linear-gradient(135deg, var(--gray-100, #f3f4f6), var(--gray-200, #e5e7eb));
  }
</style>