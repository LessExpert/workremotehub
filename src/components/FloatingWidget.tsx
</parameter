import React, { useEffect, useRef } from 'react';

const FloatingWidget: React.FC = () => {
  const containerRef = useRef<HTMLDivElement>(null);
  useEffect(() => {
    const el = containerRef.current;
    if (!el) return;
    let y = 0;
    const move = () => {
      y = (y + 1) % 100;
      el.style.transform = `translateY(${y}px)`;
      requestAnimationFrame(move);
    };
    requestAnimationFrame(move);
  }, []);

  return (
    <div
      ref={containerRef}
      className="fixed bottom-4 right-4 w-14 h-14 rounded-full bg-orange-400 shadow-lg flex items-center justify-center"
    >
      <svg className="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="12" cy="12" r="10" stroke="white" strokeWidth="2"/>
        <path d="M12 8V12L14 14" stroke="white" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"/>
      </svg>
    </div>
  );
};

export default FloatingWidget;